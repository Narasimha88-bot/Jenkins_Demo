pipeline {
    agent { label 'slave_node' }

   tools {
        maven 'maven3.9'   // Name from Global Tool Config
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Narasimha88-bot/Jenkins_Demo.git'
            }
        }

        stage('Build & Deploy') {
            steps {
                // Inject managed settings.xml from Jenkins Config File Provider
                configFileProvider([configFile(fileId: 'd2732c45-441e-483e-9295-5717053f62da', variable: 'MAVEN_SETTINGS')]) {
                    sh "mvn clean deploy -s $MAVEN_SETTINGS"
                }
            }
        }
        stage('Fetch Latest Artifact') {
            steps {
                sh '''
                # Variables
SNAPSHOT_REPO="http://18.208.178.82:8081/artifactory/lib-snapshot-local/com/example/sample-webapp/1.2-SNAPSHOT"
            TOMCAT_WEBAPPS="/opt/tomcat/tomcat-11/webapps"

               # Get latest WAR file dynamically
            LATEST_WAR=$(curl -u $USER:$PASS -s ${SNAPSHOT_REPO}/ | jq -r '.children[] | select(.uri | endswith(".war")) | .uri' | sort | tail -n1 | sed 's|/||')

            echo "Latest snapshot artifact: $LATEST_WAR"

                # Download the latest WAR
            curl -u $USER:$PASS -O ${SNAPSHOT_REPO}/$LATEST_WAR

            # Deploy to Tomcat
            cp $LATEST_WAR /opt/tomcat/tomcat-11/webapps/
            
            }
        }

        stage('Restart Tomcat') {
            steps {
                sudo systemctl restart tomcat
                echo "Tomcat restarted with latest artifact."
            }
            '''
        }
    }
    }

    post {
        success {
            echo '✅ Build and deployment to Artifactory completed successfully.'
        }
        failure {
            echo '❌ Build or deployment failed. Check logs for details.'
        }
    }
}
