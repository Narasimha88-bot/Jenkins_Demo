pipeline {
    agent { label 'slave_node' }

    tools {
        maven 'maven3.9'
    }

    stages {
        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/Narasimha88-bot/Jenkins_Demo.git'
            }
        }

        stage('Build & Push to Artifactory') {
            steps {
                configFileProvider([configFile(fileId: 'd2732c45-441e-483e-9295-5717053f62da', variable: 'MAVEN_SETTINGS')]) {
                    sh "mvn clean deploy -s $MAVEN_SETTINGS"
                }
            }
        }

        stage('Download Artifact from Artifactory') {
            steps {
                configFileProvider([configFile(fileId: 'd2732c45-441e-483e-9295-5717053f62da', variable: 'MAVEN_SETTINGS')]) {
                    sh '''
                    mvn dependency:get \
                      -DrepoId=lib-snapshot-local \
                      -DrepoUrl=http://18.208.178.82:8081/artifactory/lib-snapshot-local \
                      -Dartifact=sample-webapp-1.2-20260811.081228-1.war \
                      -s $MAVEN_SETTINGS

                    cp ~/.m2/repository/com/example/sample-webapp/sample-webapp-1.2-20260811.081228-1.war /opt/tomcat/tomcat-11/webapps/
                    '''
                }
            }
        }

        stage('Restart Tomcat') {
            steps {
                sh '''
                systemctl restart tomcat
                echo "Tomcat restarted with latest artifact."
                '''
            }
        }
    }

    post {
        success {
            echo '✅ Build, push to Artifactory, download, and Tomcat deployment completed.'
        }
        failure {
            echo '❌ Pipeline failed. Check logs for details.'
        }
    }
}
